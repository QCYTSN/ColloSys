{
  "name": "collosys",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "codecast:setup": "node scripts/codecast-setup.mjs",
    "codecast:prepare": "node scripts/codecast-prepare.mjs",
    "codecast:app": "node scripts/codecast-reference.mjs --app",
    "codecast:reference": "node scripts/codecast-reference.mjs",
    "codecast:verify": "node scripts/verify-codecast-source.mjs",
    "cost:audit": "node scripts/codecast-budget.mjs",
    "test:codecast": "node tests/codecast-reference.mjs",
    "dev": "node scripts/codecast-reference.mjs --app",
    "legacy:dev": "tsx scripts/dev.ts",
    "demo:setup": "tsx scripts/setup-demo.ts",
    "connector": "tsx packages/connector/src/cli.ts",
    "connect": "tsx scripts/connect.ts",
    "verify:codex": "tsx scripts/verify-codex.ts",
    "backend": "wrangler dev --config packages/backend/wrangler.jsonc --ip 127.0.0.1 --port 8787 --persist-to .local/cloudflare",
    "web": "vite --config packages/web/vite.config.ts --host 127.0.0.1",
    "build": "node scripts/codecast-build.mjs",
    "legacy:build": "vite build --config packages/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:integration": "node scripts/codecast-typecheck.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/acceptance.ts",
    "test:browser": "playwright test",
    "db:init": "tsx scripts/migrate.ts",
    "start": "node scripts/codecast-start.mjs",
    "design": "node scripts/codecast-design.mjs",
    "legacy:start": "tsx scripts/start.ts",
    "test:integration": "node tests/codecast-integration.mjs",
    "test:cost": "node tests/codecast-cost-audit.mjs",
    "test:backend": "node tests/codecast-backend-completion.mjs",
    "test:backend:native": "node tests/codecast-native-backend.mjs --check-launch-rejections",
    "test:desktop": "node tests/codecast-desktop.mjs",
    "legacy:package:windows": "tsx scripts/package-windows.ts",
    "test:extended": "tsx tests/extended.ts",
    "test:reliability": "tsx tests/reliability.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@pierre/diffs": "1.5.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-virtual": "3.14.2",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.2",
    "ignore": "^7.0.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.0.15",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "postcss": "^8.5.6",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "wrangler": "^4.42.0"
  }
}
