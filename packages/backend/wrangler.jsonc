{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "collosys-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "vars": { "AUTH_MODE": "development", "BACKUP_LOCATION": "local-object-storage" },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "collosys-backups" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "collosys",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "PROJECTS", "class_name": "ProjectRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }],
  "env": {
    "production": {
      "name": "collosys",
      "vars": { "AUTH_MODE": "production", "BACKUP_LOCATION": "remote-r2" },
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "REPLACE_BACKUP_BUCKET" }],
      "assets": {
        "directory": "../../dist/web",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "collosys-production",
          "database_id": "REPLACE_BEFORE_DEPLOY",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": { "bindings": [{ "name": "PROJECTS", "class_name": "ProjectRoom" }] },
    },
  },
}
